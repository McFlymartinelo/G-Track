<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
    <item>
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="45">
            <shape android:shape="rectangle">
                <size
                    android:width="6dp"
                    android:height="200dp" />
                <gradient
                    android:angle="0"
                    android:centerColor="#1A1A1A"
                    android:endColor="#00000000"
                    android:startColor="#00000000"
                    android:type="linear" />
            </shape>
        </rotate>
    </item>
    <item>
        <rotate
            android:fromDegrees="-45"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="-45">
            <shape android:shape="rectangle">
                <size
                    android:width="6dp"
                    android:height="200dp" />
                <gradient
                    android:angle="0"
                    android:centerColor="#151515"
                    android:endColor="#00000000"
                    android:startColor="#00000000"
                    android:type="linear" />
            </shape>
        </rotate>
    </item>
</layer-list>
